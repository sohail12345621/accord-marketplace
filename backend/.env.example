# Accord Backend Environment Configuration (.env.example)

# App Environment (development | production | test)
ENVIRONMENT=development

# Database Target
# SQLite (zero-setup default for dev/tests)
DATABASE_URL=sqlite:///./accord.db
# PostgreSQL (Production / Supabase / Neon / Render)
# DATABASE_URL=postgresql+psycopg://accord_user:password@localhost:5432/accord_db

# JWT & Authentication Secret (Must be >= 32 characters in production)
JWT_SECRET=accord-production-dev-jwt-secret-key-32chars-min

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Nexconn Chat SDK Integration (MANDATORY FOR LIVE HACKATHON MESSAGING)
# Obtain App Key & Secret from https://console.nexconn.ai
# CRITICAL: NEXCONN_APP_SECRET IS NEVER EXPOSED TO CLIENTS.
# It is used solely on the backend for access token issuance and webhook SHA1 verification.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_API_BASE=https://api.sg-light-api.com
NEXCONN_AREA=SG

# AI Service Provider Abstraction (Optional — Deterministic fallback mode is active if empty)
# Compatible with Gemini / OpenAI / Groq / OpenRouter / Ollama
AI_PROVIDER=none
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
COMMITMENT_MIN_CONFIDENCE=0.6
COMMITMENT_AUTO_CONFIDENCE=0.9

# Auto-seed realistic demo accounts & listings on startup
SEED_DEMO_DATA=true
