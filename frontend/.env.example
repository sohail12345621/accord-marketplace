# Accord Frontend Environment Configuration (.env.example)

# Backend API base URL (defaults to http://localhost:8000/api in development)
VITE_API_URL=http://localhost:8000/api

# Nexconn Chat SDK Public App Key
# Obtain from https://console.nexconn.ai
# CRITICAL SECURITY NOTE:
# NEVER place NEXCONN_APP_SECRET in the frontend or inside any VITE_ variable!
# The App Secret must strictly remain on the backend only.
VITE_NEXCONN_APP_KEY=
